{{!-- "Edit this page" is disabled. In its place: a link to report a problem with the page in the
      Jira SPECPR tracker (project 10041, issue type 6 "Problem Report"). The script below adds the
      page URL to the issue description. Jira asks anonymous visitors to log in first. --}}
<div class="report-problem">
  <a id="report-problem-link" href="https://openehr.atlassian.net/secure/CreateIssueDetails!init.jspa?pid=10041&amp;issuetype=6" target="_blank" rel="noopener" title="Report a problem in this specification (Jira SPECPR)">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M20 8h-2.81a5.985 5.985 0 0 0-1.82-1.96L17 4.41 15.59 3l-2.17 2.17a6.002 6.002 0 0 0-2.83 0L8.41 3 7 4.41l1.62 1.63C7.88 6.55 7.26 7.22 6.81 8H4v2h2.09c-.05.33-.09.66-.09 1v1H4v2h2v1c0 .34.04.67.09 1H4v2h2.81c1.04 1.79 2.97 3 5.19 3s4.15-1.21 5.19-3H20v-2h-2.09c.05-.33.09-.66.09-1v-1h2v-2h-2v-1c0-.34-.04-.67-.09-1H20V8zm-6 8h-4v-2h4v2zm0-4h-4v-2h4v2z"/></svg>
    <span>Report a spec issue</span>
  </a>
</div>
<script>
(function () {
  var a = document.getElementById('report-problem-link')
  if (!a) return
  var title = document.title.split(' :: ')[0]
  a.href += '&summary=' + encodeURIComponent('[' + title + '] ') +
    '&description=' + encodeURIComponent('Page: ' + location.href.split('#')[0] + (location.hash ? '\nSection: ' + location.hash : '') + '\n\nProblem:\n')
})()
</script>
