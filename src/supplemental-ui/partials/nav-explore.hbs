<div class="nav-panel-explore{{#unless page.navigation}} is-active{{/unless}}" data-panel="explore">
  {{#if page.component}}
  <div class="context">
    <span class="title">{{page.component.title}}</span>
    <span class="version">{{#if (eq page.componentVersion.version 'development')}}<span class="version-badge is-development">development</span>{{else}}{{page.componentVersion.displayVersion}}{{#if (eq page.componentVersion page.component.latest)}} <span class="version-badge is-latest">latest</span>{{/if}}{{/if}}</span>
  </div>
  {{/if}}
  <ul class="components">
    {{#each site.components}}
    <li class="component{{#if (eq this @root.page.component)}} is-current{{/if}}">
      <div class="title"><a href="{{{relativize ./url}}}">{{{./title}}}</a></div>
      {{#if (or ./versions.[1] ./versions.[0].version (ne ./versions.[0].displayVersion 'default'))}}
      <ul class="versions">
        {{#each ./versions}}
        <li class="version
          {{~#if (and (eq .. @root.page.component) (eq this @root.page.componentVersion))}} is-current{{/if~}}
          {{~#if (eq this ../latest)}} is-latest{{/if~}}
          {{~#if (eq ./version 'development')}} is-development{{/if}}">
          <a href="{{{relativize (versionLink .. this)}}}"{{#if (isSamePageVersion .. this)}} data-same-page{{/if}}>{{./displayVersion}}
            {{~#if (eq this ../latest)}}{{#unless (eq ./version 'development')}} <span class="version-badge is-latest">latest</span>{{/unless}}{{/if}}</a>
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </li>
    {{/each}}
  </ul>
</div>
<script>
  // Version switch: keep the section (#...) when the link opens the same page in another version.
  // If that section does not exist there, the browser simply shows the top of the page.
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('.nav-panel-explore a[data-same-page]')
    if (!a || !location.hash || a.hash) return
    a.hash = location.hash
  })
</script>
